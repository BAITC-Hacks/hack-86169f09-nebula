# Set these in your terminal / PyCharm run environment (.env is not auto-loaded).
# Defaults to bundled synthetic profiles. Real CSV or JSONL:
# CONTRACTORS_PATH=data/contractors.csv
PORT=8001
HOST=127.0.0.1
# Docker published port: use 0.0.0.0 for Brev Secure Links, with cloud firewall protection.
# BIND_ADDRESS=127.0.0.1
# OpenAI Platform integration (server side only):
AI_PROVIDER=openai
# OPENAI_API_KEY=your-key
OPENAI_MODEL=gpt-4.1-mini
# Optional own AI gateway using the fact-selection contract in BACKEND.md:
# AI_PROVIDER=gateway
# AI_API_URL=https://your-service.example/select-facts
# AI_API_KEY=
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
