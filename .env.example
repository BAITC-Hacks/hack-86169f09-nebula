# Set these in your terminal / PyCharm run environment (.env is not auto-loaded).
# Defaults to bundled synthetic profiles. Real CSV or JSONL:
# CONTRACTORS_PATH=data/contractors.csv
PORT=8001
HOST=127.0.0.1
# Direct NVIDIA integration (server side only):
# AI_PROVIDER=nvidia
# NVIDIA_API_KEY=your-key
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional own AI gateway using the fact-selection contract in BACKEND.md:
# AI_API_URL=https://your-service.example/select-facts
# AI_API_KEY=
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
